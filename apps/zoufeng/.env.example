# Required in production: long random string used to sign admin/customer session cookies
AUTH_SECRET=

# Optional: Turso / libSQL database (recommended for Vercel). Leave empty to use local SQLite at data/zoufeng.db
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: initial admin account created on first boot (defaults: admin@zoufeng.tw / admin12345)
ADMIN_EMAIL=
ADMIN_PASSWORD=
