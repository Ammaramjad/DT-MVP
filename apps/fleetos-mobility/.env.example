# Required in production: long random string used to sign admin/customer session cookies
AUTH_SECRET=

# Optional: Turso / libSQL database (recommended for Vercel). Leave empty to use local SQLite at data/fleetos.db
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Initial admin account created on first boot. ADMIN_PASSWORD is required in production (dev default: admin@fleetos.tw / admin12345)
ADMIN_EMAIL=
ADMIN_PASSWORD=
